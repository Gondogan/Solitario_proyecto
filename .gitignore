# ======================
# Eclipse / Workspace
# ======================

# Workspace de Eclipse, nunca debe subirse
.metadata/
.recommenders/
.loadpath

# Configuración local de Eclipse
.settings/

# Build Path y configuración del proyecto en Eclipse
# Se ignoran para que no se modifiquen entre compañeros
.project
.classpath
.factorypath

# ======================
# Compilación Java
# ======================

bin/
target/
out/
build/

# Archivos compilados
*.class

# ======================
# JAR / WAR / EAR
# ======================

# Ignorar JAR generados automáticamente
*.jar
*.war
*.ear

# Pero permitir librerías necesarias del proyecto
# Ejemplo: lib/mysql-connector-j-8.x.x.jar
!lib/
!lib/*.jar

# ======================
# Logs y temporales
# ======================

*.log
*.tmp
*.bak
*.swp

# ======================
# Sistema operativo
# ======================

# Windows
Thumbs.db
desktop.ini

# Mac
.DS_Store

# ======================
# Otros IDEs
# ======================

.idea/
*.iml
.vscode/

# ======================
# Archivos problemáticos de Eclipse / WebView
# ======================

**/EBWebView/**
**/Network/**
**/Cookies

# ======================
# Archivos de usuario / bloqueo
# ======================

*.lock
*.pid